diff --git a/kernels/dip_switch/hello.c b/kernels/dip_switch/hello.c
new file mode 100644
index 0000000..2047c2c
--- /dev/null
+++ b/kernels/dip_switch/hello.c
@@ -0,0 +1,26 @@
+#include <am.h>
+#include <klib.h>
+#include <klib-macros.h>
+
+#define GPIO_LED ((volatile uint32_t *)0x20001000)
+#define GPIO_SW  ((volatile uint32_t *)0x20001004)
+
+#define PASSWORD 0x00FF
+
+int main() {
+  putstr("Set the DIP switches to 0x00FF to unlock...\n");
+
+  while (*GPIO_SW != PASSWORD) {
+    *GPIO_LED = *GPIO_SW;
+  }
+
+  putstr("Unlocked.\n");
+
+  uint32_t pattern = 1;
+  while (1) {
+    *GPIO_LED = pattern;
+    pattern = pattern + pattern;
+    if (pattern == 0x10000) pattern = 1;
+    for (volatile int i = 0; i < 200; i++);
+  }
+}
