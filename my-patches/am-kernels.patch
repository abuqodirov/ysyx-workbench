diff --git a/kernels/csr/hello.c b/kernels/csr/hello.c
new file mode 100644
index 0000000..299d687
--- /dev/null
+++ b/kernels/csr/hello.c
@@ -0,0 +1,34 @@
+#include <am.h>
+#include <klib.h>
+#include <klib-macros.h>
+
+#define GPIO_SEG ((volatile uint32_t *)0x20001008)
+
+static void put_hex32(uint32_t v){
+	const char *d = "0123456789abcdef";
+	putch('0'); putch('x');
+	for (int i=28; i >= 0; i -= 4) putch(d[(v >> i) & 0xf]);
+}
+
+int main() {
+	uint32_t vendorid, archid;
+	asm volatile ("csrr %0, mvendorid" : "=r"(vendorid));
+	asm volatile ("csrr %0, marchid" : "=r"(archid));
+
+	putstr("mvendorid = ");
+	put_hex32(vendorid);
+	putstr("as ASCII: ");
+	putch((vendorid >> 24) & 0xff);
+	putch((vendorid >> 16) & 0xff);
+	putch((vendorid >> 8) & 0xff);
+	putch((vendorid) & 0xff);
+	putch('\n');
+
+	putstr("marchid = ");
+	put_hex32(archid);
+	putch('\n');
+
+	*GPIO_SEG = archid;
+	return 0;
+
+}	
