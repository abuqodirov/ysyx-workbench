+
+#define GPIO_LED ((volatile uint32_t *)0x20001000)
+
+int main() {
+	uint32_t pattern = 1;
+	while (1) {
+		*GPIO_LED = pattern;
+		putch('.');
+		pattern = pattern + pattern;
