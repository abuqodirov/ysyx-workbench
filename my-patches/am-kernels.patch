diff --git a/kernels/rtc/hello.c b/kernels/rtc/hello.c
new file mode 100644
index 0000000..580b243
--- /dev/null
+++ b/kernels/rtc/hello.c
@@ -0,0 +1,20 @@
+#include <am.h>
+#include <klib.h>
+#include <klib-macros.h>
+
+int main() {
+  ioe_init();                 // required: populates the ioe dispatch table
+
+  uint32_t last = (uint32_t)io_read(AM_TIMER_UPTIME).us;
+  int n = 0;
+  while (n < 10) {
+    uint32_t now = (uint32_t)io_read(AM_TIMER_UPTIME).us;
+    if (now - last >= 1000000) {   // one second in microseconds
+      last = now;
+      n++;
+      putstr("tick\n");
+    }
+  }
+  putstr("done\n");
+  return 0;
+}
