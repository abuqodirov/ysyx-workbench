diff --git a/tests/student-id/student-id.c b/tests/student-id/student-id.c
new file mode 100644
index 0000000..c048087
--- /dev/null
+++ b/tests/student-id/student-id.c
@@ -0,0 +1,35 @@
+#include <am.h>
+#include <klib.h>
+
+#define GPIO_SEG ((volatile uint32_t *)0x20001008)
+
+static void wait_cycles(uint32_t n) {
+	uint32_t start, now;
+	asm volatile ("csrr %0, mcycle" : "=r"(start));
+	do {asm volatile ("csrr %0, mcycle" : "=r"(now)); } while (now - start < n);
+}
+
+int main(const char *args) {
+	uint32_t vendor, arch;
+
+	asm volatile ("csrr %0, mvendorid" : "=r"(vendor));
+	asm volatile ("csrr %0, marchid" : "=r"(arch));
+
+	printf("mvendorid = 0x%08x  (\"%c%c%c%c\")\n", vendor,
+         (vendor >> 24) & 0xff, (vendor >> 16) & 0xff,
+         (vendor >>  8) & 0xff,  vendor        & 0xff);
+  printf("marchid   = %d  (0x%08x)\n", arch, arch);
+  printf("student ID: ysyx_%08d\n", arch);
+
+  *GPIO_SEG = 0x01234567;  wait_cycles(8000000);  
+  *GPIO_SEG = 0x89abcdef;  wait_cycles(8000000);
+  *GPIO_SEG = arch;
+
+	uint32_t c[4];
+  for (int i = 0; i < 4; i++) asm volatile ("csrr %0, mcycle" : "=r"(c[i]));
+  for (int i = 0; i < 4; i++)
+    printf("mcycle read %d = %d  (+%d)\n", i, c[i], i ? c[i] - c[i - 1] : 0);
+  for (int i = 1; i < 4; i++) if (c[i] <= c[i - 1]) return 2;
+
+	return vendor == 0x79737978 ? 0 : 1;
+}
